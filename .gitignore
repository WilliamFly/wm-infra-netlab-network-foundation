.env
.env.*
!.env.example
*.pem
*.key
!*.pub.key
vault_pass*
.vault-password

# --- Terraform ---
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# --- Ansible ---
*.retry
inventory/host_vars/*/vault.yml
!inventory/host_vars/*/vault.yml.example

# --- Packer ---
packer_cache/
*.pkrvars.hcl
!*.pkrvars.hcl.example

